# ElevenLabs Configuration
# Get your API key from: https://elevenlabs.io/settings/api-keys
ELEVENLABS_API_KEY=your_api_key_here

# Optional: Voice ID override for the tour backend
# ELEVENLABS_VOICE_ID_ES=qSeXEcewz7tA0Q0qk9fH
# ELEVENLABS_VOICE_ID_EN=dlGxemPxFMTY7iXagmOj

# Optional: Model override
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Optional: Local backend port
# AUDIO_BACKEND_PORT=3001

# Environment
NODE_ENV=development
